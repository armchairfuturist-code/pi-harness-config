{
  "lastChangelogVersion": "0.84.1",
  "theme": "dark",
  "// provider-agnostic": "Provider/model/thinking intentionally NOT committed here. This repo is provider-agnostic: live machines pick a provider via `pi auth login` and store the choice in ~/.pi/agent/settings.json (defaultProvider, defaultModel, defaultThinkingLevel, enabledModels) plus model-thinking.json / workflows/model-tiers.json. install.sh preserves all of those on reinstall; repo values are first-run fallbacks only.",
  "packages": [
    "npm:@ogulcancelik/pi-model-thinking@0.1.0",
    "npm:@plannotator/pi-extension@0.26.7",
    "npm:context-mode@1.0.169",
    "npm:pi-autoresearch@1.6.2",
    "npm:pi-cache-optimizer@2.8.2",
    "npm:pi-context-usage@1.0.2",
    "npm:pi-continue@0.9.3",
    "npm:pi-lean-ctx@3.9.18",
    "npm:pi-slim@0.2.1",
    "npm:pi-tscg@0.2.4",
    "npm:@quintinshaw/pi-dynamic-workflows@3.5.1",
    "npm:@samfp/pi-essentials@0.2.3",
    "npm:pi-clarify@1.0.1",
    "npm:@howaboua/pi-smart-btw@0.2.6",
    "npm:@howaboua/pi-skill-model-facing-api-design@0.0.5",
    "npm:@howaboua/pi-auto-reasoning-tool@0.1.11"
  ],
  "extensions": [
    "~/.pi/agent/extensions/transcript-pruner.ts",
    "~/.pi/agent/extensions/session-index.ts",
    "~/.pi/agent/extensions/runtime-discipline.ts",
    "~/.pi/agent/extensions/rot-sentinel.ts",
    "~/.pi/agent/extensions/ce-lite-preload.ts",
    "~/.pi/agent/extensions/enforce-tool-profile.ts"
  ],
  "steeringMode": "all",
  "hideThinkingBlock": true,
  "compaction": {
    "reserveTokens": 24000,
    "keepRecentTokens": 20000,
    "enabled": true
  },
  "defaultProvider": "synthetic",
  "defaultModel": "syn:small:text",
  "defaultThinkingLevel": "off",
  "retry": {
    "enabled": true
  }
}