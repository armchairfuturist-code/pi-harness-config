          "text": "\"use client\";\n\nimport { MessageCircle, X, Send } from \"lucide-react\";\nimport { useChat } from \"@/hooks/useChat\";\n\n/**\n * ChatWidget — the floating \"have questions?\" bubble in the corner of the\n * site. Pure renderer: all state and side effects live in `useChat`. The\n * component's only job is to lay out the open/closed states and forward\n * user input to the hook.\n */\nexport default function ChatWidget() {\n  const {\n    isOpen,\n    hasStarted,\n    messages,\n    input,\n    isLoading,\n    messagesEndRef,\n    open,\n    toggle,\n    setInput,\n    send,\n    handleKeyDown,\n  } = useChat();\n\n  return (\n    <div className=\"fixed bottom-4 right-4 z-50 flex flex-col items-end gap-2\">\n      {isOpen && (\n        <div className=\"mb-2 w-80 md:w-96 rounded-2xl bg-white shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[500px]\">\n          <div className=\"bg-navy text-white px-4 py-3 flex items-center justify-between\">\n            <div>\n              <h3 className=\"font-semibold text-sm\">Mindscape Assistant</h3>\n              <p className=\"text-xs text-white/70\">Ask about our programs</p>\n            </div>\n            <button\n              onClick={toggle}\n              className=\"p-1 hover:bg-white/10 rounded-lg transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50 max-h-80\">\n            {messages.map((msg, i) => (\n              <div\n                key={i}\n                className={`flex ${msg.role === \"user\" ? \"justify-end\" : \"justify-start\"}`}\n              >\n                <div\n                  className={`max-w-[85%] rounded-2xl px-4 py-2.5 text-sm leading-relaxed whitespace-pre-wrap ${\n                    msg.role === \"user\"\n                      ? \"bg-navy text-white rounded-br-md\"\n                      : \"bg-white text-slate-700 border border-slate-200 rounded-bl-md\"\n                  }`}\n          ... [truncated]",
