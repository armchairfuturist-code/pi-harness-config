          "text": "import json\nimport os\nimport shutil\n\n# Paths\nstate_path = \"/home/alex/.pi/agent/.cache/smart-compact/states/proj-2cc974af6afc.json\"\nbak_path = state_path + \".bak\"\nconsolidated_md_path = \"/home/alex/.pi/agent/memory/consolidated.md\"\n\n# 1. Back up\nprint(f\"Backing up {state_path} to {bak_path}\")\nshutil.copy2(state_path, bak_path)\n\n# 2. Read state file\nwith open(state_path, 'r') as f:\n    state_data = json.load(f)\n\n# Keep track of original keys to ensure we preserve JSON schema exactly\noriginal_keys = list(state_data.keys())\n\n# Get constraints\nconstraints = state_data.get(\"constraints\", [])\n\n# Group identical constraints by text\ngrouped_by_text = {}\nfor c in constraints:\n    text = c[\"text\"]\n    if text not in grouped_by_text:\n        grouped_by_text[text] = []\n    grouped_by_text[text].append(c)\n\nconsolidated_constraints = []\nfor text, group in grouped_by_text.items():\n    if len(group) == 1:\n        # Genuinely distinct constraint verbatim\n        consolidated_constraints.append(group[0])\n    else:\n        # Near-duplicates to merge: keep highest confidence\n        group_sorted = sorted(group, key=lambda x: x.get(\"confidence\", 0), reverse=True)\n        best_instance = dict(group_sorted[0])\n        # Record merged sources\n        merged_source_ids = [item[\"id\"] for item in group]\n        best_instance[\"sources\"] = merged_source_ids\n        consolidated_constraints.append(best_instance)\n\n# Sort consolidated constraints by id/original placement to keep order neat\n# Wait, constraint-4 has id \"constraint-4\"\ndef get_id_num(c):\n    try:\n        return int(c[\"id\"].split(\"-\")[1])\n    except Exception:\n        return 999\n\nconsolidated_constraints = sorted(consolidated_constraints, key=get_id_num)\n\n# Update state data\nstate_data[\"constraints\"] = consolidated_constraints\n\n# Ensure keys are unchanged\nassert list(state_data.keys()) == original_keys, \"JSON schema keys modified!\"