  "script": "export const meta = {\n  name: \"ce-lite-vs-mattpocock-skills\",\n  description: \"WGS + mattpocock/skills vs ce-lite — lean pass\",\n  phases: [{ title: \"Fanout\" }, { title: \"Synth\" }],\n};\n\nphase(\"Fanout\");\n\nconst ctx = `\nSTACK: pi harness; ce-lite orchestrates contract loop grill→terms→plan→execute→verify→compound; operator control; handoff-before-rot; wayfinding multi-session; workflow for multi-agent; compose skills don't reimplement; lean-ctx/tiers/.scratch.\n\nWGS BAR: WHAT+WHEN descriptions w/ negative triggers; progressive disclosure; imperative steps; degrees-of-freedom match fragility; compose not monolith; no vague consider/should; feedback loops; no skill-trigger collisions.\n\nMATT USER-INVOKED: ask-matt, grill-with-docs, triage, improve-codebase-architecture, setup-matt-pocock-skills, to-spec, to-tickets, implement, wayfinder\nMATT MODEL-INVOKED: prototype, diagnosing-bugs, research, tdd, domain-modeling, codebase-design, code-review, resolving-merge-conflicts\nALL installed stock locally.\n\nLOCAL COLLISION ZONE: grilling, grill-me, grill-with-docs; ce-lite/wayfinding.md vs wayfinder; handoff vs context-health; ce-lite should delegate not duplicate.\nLOCAL-ONLY: writing-great-skills, harness-doctor, context-rot-forensics, poor-mans-distill, shard-security, graph-engineering, prompt-sharpen, no-ai-slop, teach, to-questionnaire, ponytail*.\n\nMATT NOTES: to-spec freezes reqs; to-tickets vertical slices/issue-tracker; implement→tdd+code-review; wayfinder multi-session roadmap; grill-with-docs doc-grounded adversarial Qs; triage routes; improve-codebase-architecture heavyweight HTML reports; philosophy=small composable, operator depth, anti-GSD takeover.\n`;\n\nconst [inventory, fit, quality] = await parallel([\n  () =>\n    agent(\n      `${ctx}\n\nMap EACH matt skill: role | local status | ce-lite phase | collision (name other skill).\nThen: gaps | local-only strengths | dangerous duplicates.\nMax 400 words. Bullets only.`,\n      { label: \"inv\", tier: \"medium\" }\n    ),\n  () =>\n    agent(\n      `${ctx}\n\nPer matt skill: FIT|ADAPT|SKIP|REPLACE + 1-line why.\nThen: phase→delegate wiring for ce-lite; do-not-auto-invoke list; pi-harness friction (3 bullets).\nMax 450 words.`,\n      { label: \"fit\", tier: \"big\" }\n    ),\n  () =>\n    agent(\n      `${ctx}\n\nWGS audit of matt set: grade A-F; best 3; worst 3 + violations; steal vs don't-copy (3 each).\nMax 300 words.`,\n      { label: \"qual\", tier: \"medium\" }\n    ),\n]);\n\nphase(\"Synth\");\n\nconst synthesis = await agent(\n  `Synthesize actionable plan for operator.\n\nINVENTORY:\n${inventory || \"null\"}\n\nFIT:\n${fit || \"null\"}\n\nQUALITY:\n${quality || \"null\"}\n\nOutput markdown only:\n\n# mattpocock × ce-lite\n\n## Verdict\n(3-5 sentences)\n\n## Wire into ce-lite\nphase → skill(s)\n\n## Keep / Adapt / Demote\nthree short lists\n\n## Gaps to author (WGS)\nname + one-line description (WHAT+WHEN) each\n\n## Duplicate cleanup\nconcrete negative-trigger / merge actions\n\n## Next 5 actions\nfile paths under skills/\n\nHard cap ~700 words. Opinionated. No URLs.`,\n  { label: \"syn\", tier: \"big\" }\n);\n\nreturn { inventory, fit, quality, synthesis };",
