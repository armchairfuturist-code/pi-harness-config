{
  "runId": "memory-consolidate-ms5qqg07-3348x6",
  "workflowName": "memory-consolidate",
  "script": "export const meta = {\n  name: \"memory-consolidate\",\n  description: \"Merge smart-compact memory extractions: dedupe constraints, reconcile decisions, promote durable learnings. Run at handoff or session end.\",\n  phases: [{ title: \"Collect\" }, { title: \"Consolidate\" }],\n}\n\nconst stateDir = args.stateDir || \"$HOME/.pi/agent/.cache/smart-compact\"\nconst learningsFile = args.learningsFile || \"$HOME/.pi/agent/memory/consolidated.md\"\nconst dryRun = String(args.dryRun ?? \"false\") === \"true\"\n\nconst CONTRACT = {\n  type: \"object\",\n  required: [\"outcome\", \"evidence\", \"changes\", \"decisions\", \"failures_risks\", \"new_tasks\", \"payload_json\"],\n  properties: {\n    outcome: { type: \"string\", description: \"What was done/found, 1-3 sentences\" },\n    evidence: { type: \"string\", description: \"Checkable proof: paths, excerpts\" },\n    changes: { type: \"array\", items: { type: \"string\" } },\n    decisions: { type: \"array\", items: { type: \"string\" } },\n    failures_risks: { type: \"array\", items: { type: \"string\" } },\n    new_tasks: { type: \"array\", items: { type: \"string\" } },\n    payload_json: { type: \"string\", description: \"JSON string; empty object {} when unused\" },\n  },\n}\n\nphase(\"Collect\")\nlet inventory = null\ntry {\n  inventory = await agent(\n    `You are collecting an agent harness's processed-memory store for consolidation. Read every JSON file under ${stateDir} (states/*.json, projects/*.json, and remediation-*.json at the root; skip *.bak sidecars and damage-reports.jsonl). Expand $HOME via the shell.\\nReturn the worker contract JSON. Put the full inventory in payload_json as a JSON string: for each state file, its path, goal, constraints (id, text, category, confidence), decisions, and modifiedFiles. Copy values verbatim; do not editorialize or drop entries.`,\n    { label: \"collect-memory\", schema: CONTRACT }\n  )\n} catch (err) {\n  return { report: `memory-consolidate: collection failed (${String(err)}). Nothing was changed.`, incomplete: true }\n}\nlet payload = null\nif (inventory && typeof inventory.payload_json === \"string\") {\n  try { payload = JSON.parse(inventory.payload_json) } catch { payload = null }\n}\nif (!inventory || !payload) {\n  return { report: \"memory-consolidate: no usable memory inventory collected (missing coverage, not an empty store). Nothing was changed.\", incomplete: true }\n}\n\nphase(\"Consolidate\")\nlet result = null\ntry {\n  result = await agent(\n    `Consolidate this processed-memory inventory (JSON below) from an agent harness.\\nRules:\\n1. Merge near-duplicate constraints (same instruction re-extracted across sessions): keep the highest-confidence instance, record merged sources on it, drop the rest. Preserve every genuinely distinct constraint verbatim.\\n2. Never resolve contradictions silently — list any contradictory constraints or decisions in failures_risks.\\n3. Where a later decision reverses an earlier one, keep the current decision and annotate the earlier one \\\"superseded by <decision text/id>\\\" — never delete the record.\\n4. ${dryRun ? \"DRY RUN: write nothing. Report exactly what you would change.\" : `Rewrite each source state file under ${stateDir} with its consolidated content, preserving each file's existing JSON schema exactly (same keys). Back up each file to <file>.bak before overwriting. Expand $HOME via the shell.`}\\n5. Promote durable, reusable learnings (operator preferences, confirmed gotchas, cross-session facts) by appending them as bullets to ${learningsFile} (create it if missing). Skip session-specific trivia.\\nInventory:\\n${JSON.stringify(payload)}\\nReturn the worker contract JSON (payload_json unused; return {}).`,\n    { label: \"consolidate-memory\", schema: CONTRACT }\n  )\n} catch (err) {\n  return { report: `memory-consolidate: consolidation failed (${String(err)}). State files may be partially written; .bak sidecars exist for recovery.`, collect: inventory, incomplete: true }\n}\nif (!result) {\n  return { report: \"memory-consolidate: consolidation agent returned nothing (missing coverage). Inventory was collected; state files unchanged.\", collect: inventory, incomplete: true }\n}\n\nlog(\"memory-consolidate complete\")\nreturn {\n  report: `${result.outcome}\\nEvidence: ${result.evidence}\\nChanges: ${(result.changes || []).join(\"; \") || \"none\"}\\nRisks: ${(result.failures_risks || []).join(\"; \") || \"none\"}\\nNew tasks: ${(result.new_tasks || []).join(\"; \") || \"none\"}`,\n  dryRun,\n  collect: { outcome: inventory.outcome, evidence: inventory.evidence },\n  consolidate: result,\n}",
  "args": {
    "dryRun": "true"
  },
