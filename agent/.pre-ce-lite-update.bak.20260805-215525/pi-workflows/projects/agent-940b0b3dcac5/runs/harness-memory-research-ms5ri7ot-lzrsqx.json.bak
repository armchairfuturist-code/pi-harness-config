          "text": "{\"command\":\"curl -s https://raw.githubusercontent.com/chandra447/pi-hermes-memory/main/src/prompt-context.ts || curl -s https://raw.githubusercontent.com/chandra447/pi-hermes-memory/master/src/prompt-context.ts\"}",
