          "text": "{\"command\":\"curl -s https://raw.githubusercontent.com/coleam00/claude-memory-compiler/main/README.md | head -n 120 || curl -s https://raw.githubusercontent.com/coleam00/claude-memory-compiler/master/README.md | head -n 120\"}",
