          "text": "\"use client\";\n\n// WORKSTATION '99 hero viewport — one low-poly chrome construct that\n// slowly rotates, leans toward the cursor, and re-meshes as the user\n// explores the service modules below the frame.\n//\n// Perf contract:\n//  - dynamic-imported with ssr:false, desktop-only decision is the caller's\n//  - DPR capped at 1.5, rAF paused when hidden or offscreen\n//  - reduced-motion means this component is never mounted\n\nimport { useEffect, useRef } from \"react\";\nimport * as THREE from \"three\";\nimport { RoomEnvironment } from \"three/examples/jsm/environments/RoomEnvironment.js\";\n\ninterface Viewport3DProps {\n  /** 0..4 — which service module geometry to show */\n  active: number;\n}\n\nconst GEOMETRIES: Array<() => THREE.BufferGeometry> = [\n  () => new THREE.IcosahedronGeometry(1.05, 0),\n  () => new THREE.TorusKnotGeometry(0.62, 0.2, 72, 9),\n  () => new THREE.OctahedronGeometry(1.2, 0),\n  () => new THREE.TorusGeometry(0.92, 0.32, 8, 20),\n  () => new THREE.DodecahedronGeometry(1.1, 0),\n];\n\nexport default function Viewport3D({ active }: Viewport3DProps) {\n  const mountRef = useRef<HTMLDivElement>(null);\n  const groupRef = useRef<{\n    mesh: THREE.Mesh;\n    wire: THREE.Mesh;\n    satellites: THREE.Object3D[];\n    ring: THREE.Object3D;\n  } | null>(null);\n  const activeRef = useRef(active);\n  const swapGeometryRef = useRef<(() => void) | null>(null);\n\n  // Keep the latest module index visible to the render-loop effect\n  useEffect(() => {\n    activeRef.current = active;\n    swapGeometryRef.current?.();\n  }, [active]);\n\n  useEffect(() => {\n    const mount = mountRef.current;\n    if (!mount) return;\n\n    // Orthopedic three evidence: renderer -> scene -> camera -> lights\n    let renderer: THREE.WebGLRenderer;\n    try {\n      renderer = new THREE.WebGLRenderer({\n        antialias: true,\n        powerPreference: \"high-performance\",\n      });\n    } catch {\n      // WebGL unavailable — the caller still has the SVG fallback hidden\n      // behind us; fail silently an... [truncated]",
