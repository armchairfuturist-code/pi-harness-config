          "text": "\"use client\";\n\n// Terminal-style introduction — a POST sequence that types itself once.\n// Skippable (click / keypress) and fully static under reduced-motion.\n// All content is server-rendered below via <noscript>-safe sr-only copy.\n\nimport { useEffect, useRef, useState } from \"react\";\nimport { useReducedMotion } from \"motion/react\";\n\nconst LINES = [\n  \"ARMCHAIR.SYS v2.6 — power-on self test\",\n  \"mounting user.model ........... OK\",\n  \"consultant.dependency ......... 0 modules\",\n  \"fluency.kernel ................ loaded\",\n  \"viewport on-line\",\n];\n\nexport default function TerminalBoot({ className = \"\" }: { className?: string }) {\n  const prefersReduced = useReducedMotion();\n  const [charCount, setCharCount] = useState(prefersReduced ? Infinity : 0);\n  const [done, setDone] = useState(!!prefersReduced);\n  const total = LINES.reduce((n, l) => n + l.length, 0);\n  const skipRef = useRef<() => void>(() => {});\n\n  skipRef.current = () => {\n    setCharCount(Infinity);\n    setDone(true);\n  };\n\n  useEffect(() => {\n    if (prefersReduced) return;\n    if (done) return;\n    const id = window.setInterval(() => {\n      setCharCount((c) => {\n        const next = c + 1;\n        if (next >= total + 4) {\n          window.clearInterval(id);\n          setDone(true);\n        }\n        return next;\n      });\n    }, 18);\n    return () => window.clearInterval(id);\n  }, [prefersReduced, done, total]);\n\n  // Keypress skips wherever focus lives inside the terminal\n  const onKeyDown = (e: React.KeyboardEvent) => {\n    if (!done) {\n      e.stopPropagation();\n      skipRef.current();\n    }\n  };\n\n  // Render the typed portion of characters across lines\n  let remaining = Math.min(charCount, total);\n  const typedLines = LINES.map((line) => {\n    if (remaining <= 0) return \"\";\n    const part = line.slice(0, remaining);\n    remaining -= line.length;\n    return part;\n  });\n\n  return (\n    <div\n      role={done ? \"presentation\" : \"button\"}\n      tabIndex={done ? -1 : 0}\n      aria-la... [truncated]",
