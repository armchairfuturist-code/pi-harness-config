# Secrets — never commit
auth.json
models-store.json
web-search.json
*.key
*.pem

# Large binary assets
*.zip
*.mp3
*.jpeg
*.jpg
*.png
*.pdf

# OS cruft
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc

# machine-local model list (repo is provider-agnostic)
models.json
# Agent runtime (if someone clones into ~/.pi/agent)
sessions/
npm/
node_modules/
context-mode/
workflows/projects/
**/__pycache__/
**/*.py[cod]
skills/**/assets/
agent/git/
memory/
!memory/consolidated.md
!memory/harnesses.md
!memory/user-shell.md
!memory/sess-themes.md
scripts/harness-preflight.sh.bak
.scratch/

# Live agent home is deploy output, never source. install.sh copies the repo
# into ~/.pi/agent; nothing under agent/ is tracked or should be committed.
# (Protects machine-local files like settings.json, model-thinking.json,
# pi-smart-btw.json from git operations when the clone lives at ~/.pi.)
agent/

# iter11 observe/verify log leftovers
hil/.scratch-*
hil/traces/
hil/verifications/
# Generated benchmark output (noise)
bench/out/



# external skill clones (ponytail, etc.)
git/
__pycache__/
